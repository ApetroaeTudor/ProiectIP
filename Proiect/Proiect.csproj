<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.8">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Common">
	    <HintPath>..\Common\bin\Debug\net10.0-windows10.0.22621.0\Common.dll</HintPath>
	  </Reference>
	  <Reference Include="CustomExceptions">
	    <HintPath>..\FileManagement\bin\Debug\net10.0-windows10.0.22621.0\CustomExceptions.dll</HintPath>
	  </Reference>
	  <Reference Include="FileManagement">
	    <HintPath>..\FileManagement\bin\Debug\net10.0-windows10.0.22621.0\FileManagement.dll</HintPath>
	  </Reference>
	</ItemGroup>

</Project>